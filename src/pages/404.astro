</Base>

<style>
  .nf {
    padding-top: 6rem;
    min-height: 50vh;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.8rem);
  }
  p {
    margin-top: 1.5rem;
  }
</style>
