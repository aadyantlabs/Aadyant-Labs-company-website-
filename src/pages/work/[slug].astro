---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, tag, summary, client, built, stack, live, quote } = entry.data;
const { Content } = await render(entry);
---

<Base title={`${title} case study | Aadyant Labs`} description={`${title}: ${summary}`}>
  <header class="top dark">
    <div class="wrap">
      <div class="col">
        <p class="back"><a href="/#work">All work</a></p>
        <p class="kicker">{tag}</p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
        {live && <p class="live"><a class="btn btn-bright" href={live}>Visit the live site</a></p>}
      </div>
    </div>
  </header>

  <article class="wrap">
    <div class="col">
      <div class="shot"><Shot slug={entry.id} /></div>

      <div class="body">
        <section data-reveal>
          <h2>The client and their problem</h2>
          <p class="client">{client}</p>
          <Content />
        </section>

        <section data-reveal>
          <h2>What we built</h2>
          <ul class="built" role="list">
            {
              built.map((b) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M5 10.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {b}
                </li>
              ))
            }
          </ul>
        </section>

        {
          stack.length > 0 && (
            <section data-reveal>
              <h2>Stack</h2>
              <ul class="stack" role="list">
                {stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          quote && (
            <blockquote data-reveal>
              <p>{quote.text}</p>
              <footer>{quote.by}</footer>
            </blockquote>
          )
        }
      </div>

      <div class="cta" data-reveal>
        <p>Need something like this?</p>
        <a class="btn" href="/#contact">Tell us what you want to build</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .top {
    padding: calc(var(--hero-gap) - 1rem) 0 10rem;
    background:
      radial-gradient(600px 400px at 0% 0%, rgba(14, 122, 109, 0.6), transparent 70%),
      radial-gradient(600px 400px at 100% 100%, rgba(59, 47, 143, 0.55), transparent 70%),
      var(--ink);
  }

  .back a {
    display: inline-block;
    padding: 0.6rem 0;
    margin-bottom: var(--s-2);
  }

  h1 {
    font-size: clamp(var(--t-49), 8vw, 6rem);
    font-stretch: 85%;
    color: var(--white);
  }

  .lede {
    font-size: var(--t-20);
    margin-top: var(--s-2);
    color: var(--on-dark-muted);
  }

  .live {
    margin-top: var(--s-3);
  }

  .shot {
    margin: -7rem 0 var(--s-6);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
  }

  .body {
    display: grid;
    gap: var(--s-6);
    max-width: 46rem;
  }

  h2 {
    font-size: var(--t-31);
    margin-bottom: var(--s-2);
  }

  .body :global(p + p) {
    margin-top: var(--s-2);
  }

  .client {
    font-weight: 700;
    margin-bottom: var(--s-2);
  }

  .built,
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .built li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: var(--white);
    border: 1px solid rgba(24, 32, 65, 0.07);
  }

  .built svg {
    flex: none;
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 50%;
    background: var(--teal-50);
    color: var(--thread);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
  }

  .stack li {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: var(--t-14);
  }

  blockquote {
    margin: 0;
    padding: var(--s-4);
    border-radius: var(--radius-lg);
    background: var(--marigold-50);
    font: 600 var(--t-25) / 1.3 var(--font-display);
  }

  blockquote footer {
    margin-top: var(--s-2);
    color: var(--slate);
    font: 400 var(--t-16) / 1.4 var(--font-body);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin: var(--section-gap) 0;
    padding: var(--s-4);
    border-radius: var(--radius-lg);
    background: var(--teal-50);
  }

  .cta p {
    font: 700 var(--t-25) / 1.2 var(--font-display);
  }
</style>
