---
import Base from '../layouts/Base.astro';
import Thread from '../components/Thread.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base
  title="Aadyant Labs: websites and software from Mangaluru"
  description="A small team of engineers from Mangaluru. We build websites, web apps and custom tools at fixed prices, and you own everything we build."
>
  <div class="threaded wrap">
    <Thread />
    <Hero />
    <Work />
    <Services />
    <Process />
    <Team />
    <Faq />
    <ContactForm />
  </div>
</Base>

<style>
  .threaded {
    position: relative;
  }
</style>
