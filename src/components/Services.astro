---
import { services } from '../data/site';

const icons = [
  // browser window
  '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18"/><circle cx="6.5" cy="6.5" r=".6" fill="currentColor"/><circle cx="9" cy="6.5" r=".6" fill="currentColor"/>',
  // dashboard
  '<rect x="3" y="3" width="8" height="10" rx="2"/><rect x="13" y="3" width="8" height="6" rx="2"/><rect x="13" y="11" width="8" height="10" rx="2"/><rect x="3" y="15" width="8" height="6" rx="2"/>',
  // gear/tool
  '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>',
];

const always = ['Mobile-first design', 'Fast on cheap phones', 'Basic SEO set up', 'Hosting in your name', 'You own the code'];
---

<section id="services" class="stop band" aria-labelledby="services-title">
  <div class="wrap">
    <div class="col">
      <div class="section-head" data-reveal>
        <p class="kicker">Services</p>
        <h2 id="services-title">What we build</h2>
        <p class="muted">Three kinds of work, each with a fixed price agreed before we start.</p>
      </div>

      <ul class="rows" role="list">
        {
          services.map((s, i) => (
            <li class="row" data-reveal style={`--d: ${i * 90}ms`}>
              <span class={`icon i${i}`} aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
              </span>
              <h3>{s.name}</h3>
              <p class="inc">{s.includes}</p>
              <p class="price">
                {s.quoted ? 'Quoted per project' : s.from ? `From ${s.from}` : 'Quoted after a free call'}
              </p>
            </li>
          ))
        }
      </ul>

      <div class="always" data-reveal>
        <p>Always included</p>
        <ul role="list">
          {
            always.map((a) => (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5 10.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {a}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem var(--s-3);
    padding: var(--s-3);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid rgba(24, 32, 65, 0.07);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: linear-gradient(var(--marigold), var(--teal-bright));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s var(--ease);
  }

  .row:hover {
    transform: translateX(6px);
    box-shadow: var(--shadow-lg);
  }

  .row:hover::before {
    transform: scaleY(1);
  }

  .icon {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--teal-50);
    color: var(--thread);
    transition: transform 0.5s var(--ease);
  }

  .i1 {
    background: var(--marigold-50);
    color: #9a6700;
  }

  .i2 {
    background: #e7e5fb;
    color: #4c3fb5;
  }

  .row:hover .icon {
    transform: rotate(-8deg) scale(1.08);
  }

  .icon svg {
    width: 28px;
    height: 28px;
  }

  h3 {
    font-size: var(--t-25);
    align-self: end;
  }

  .inc {
    color: var(--slate);
  }

  .price {
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: var(--t-14);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: auto 1.1fr 1.6fr auto;
      align-items: center;
      padding: var(--s-4) var(--s-4);
    }
    .icon {
      grid-row: auto;
    }
    h3 {
      align-self: center;
    }
    .price {
      margin: 0;
    }
  }

  .always {
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }

  .always > p {
    font-weight: 700;
  }

  .always ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .always li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem 0.4rem 0.6rem;
    border-radius: 999px;
    background: var(--teal-50);
    color: var(--thread-dark);
    font-size: var(--t-14);
    font-weight: 700;
  }

  .always svg {
    width: 16px;
    height: 16px;
  }
</style>
