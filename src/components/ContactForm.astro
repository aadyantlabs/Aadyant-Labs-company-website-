---
import { email, formKey, whatsappLink } from '../data/site';
---

<section id="contact" class="stop contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="col">
      <div class="card" data-reveal>
        <div class="panel dark" data-spotlight>
          <span class="spot" aria-hidden="true"></span>
          <p class="kicker">Start a project</p>
          <h2 id="contact-title">Tell us what you want to build</h2>
          <p class="muted">We reply within one working day with next steps and a time for a free 30-minute call.</p>

          <ul class="next" role="list">
            <li><span>1</span>You send the details</li>
            <li><span>2</span>We call and ask questions</li>
            <li><span>3</span>You get a fixed price in 2 days</li>
          </ul>

          <div class="direct">
            {
              whatsappLink && (
                <a class="btn btn-whatsapp" href={whatsappLink}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.2 0-5.4 4.4-9.8 9.8-9.8 2.6 0 5.1 1 6.9 2.9 1.8 1.8 2.9 4.3 2.9 6.9 0 5.4-4.4 9.8-9.8 9.8zm8.4-18.2C18.1 1.3 15.1 0 12 0 5.4 0 .1 5.3.1 11.9c0 2.1.6 4.1 1.6 5.9L0 24l6.3-1.7c1.7.9 3.7 1.4 5.7 1.4 6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.5-8.4z"
                    />
                  </svg>
                  Message us on WhatsApp
                </a>
              )
            }
            <a class="mail" href={`mailto:${email}`}>{email}</a>
          </div>
        </div>

        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
          <input type="hidden" name="access_key" value={formKey} />
          <input type="hidden" name="subject" value="New project enquiry from aadyantlabs.dev" />
          <input type="hidden" name="from_name" value="Aadyant Labs website" />
          <input type="checkbox" name="botcheck" style="display: none" />

          <div class="pair">
            <div class="field">
              <label for="f-name">Your name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
              <p class="err" id="e-name" data-msg="Enter your name so we know who to reply to."></p>
            </div>

            <div class="field">
              <label for="f-contact">Phone or email</label>
              <input id="f-contact" name="contact" type="text" autocomplete="email" required aria-describedby="e-contact" />
              <p class="err" id="e-contact" data-msg="Enter a phone number or email so we can reply."></p>
            </div>
          </div>

          <fieldset class="field">
            <legend>What you need</legend>
            <div class="choices">
              {
                ['Website', 'Web app', 'Custom tool', 'Not sure yet'].map((c, i) => (
                  <label class="choice">
                    <input type="radio" name="need" value={c} checked={i === 3} />
                    <span>{c}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="pair">
            <div class="field">
              <label for="f-budget">Budget range</label>
              <select id="f-budget" name="budget">
                <option>Under ₹25,000</option>
                <option>₹25,000 to ₹75,000</option>
                <option>₹75,000 to ₹2,00,000</option>
                <option>Above ₹2,00,000</option>
                <option selected>Not sure yet</option>
              </select>
            </div>
            <div class="field">
              <label for="f-when">When you need it</label>
              <select id="f-when" name="when">
                <option>Within 2 weeks</option>
                <option>Within a month</option>
                <option>In 1 to 3 months</option>
                <option selected>No fixed date</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-desc">A short description</label>
            <textarea
              id="f-desc"
              name="message"
              rows="4"
              required
              aria-describedby="e-desc"
              placeholder="What is it for, and who will use it?"></textarea>
            <p class="err" id="e-desc" data-msg="Add a line or two about the project so we can prepare for the call."></p>
          </div>

          <button class="btn" type="submit">Send project details</button>
          <p class="result" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: var(--section-gap);
  }

  /* The thread ends here: a short turn into the card */
  .contact::after {
    content: '';
    position: absolute;
    left: var(--line-x);
    bottom: calc(var(--section-gap) + 56px);
    width: calc(var(--gutter) - var(--thread-x));
    height: 2.5px;
    background: var(--thread);
    z-index: 2;
  }

  .card {
    display: grid;
    border-radius: 28px;
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 1000px) {
    .card {
      grid-template-columns: 0.9fr 1.2fr;
    }
  }

  .panel {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    background:
      radial-gradient(500px 300px at 0% 0%, rgba(14, 122, 109, 0.7), transparent 70%),
      radial-gradient(400px 300px at 100% 100%, rgba(227, 162, 26, 0.35), transparent 70%),
      var(--ink);
  }

  .spot {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(300px circle at var(--mx, -400px) var(--my, -400px), rgba(255, 255, 255, 0.1), transparent 70%);
  }

  .panel .kicker {
    justify-self: start;
    margin: 0;
  }

  h2 {
    color: var(--white);
    font-size: clamp(var(--t-31), 3.6vw, var(--t-49));
  }

  .next {
    list-style: none;
    margin: var(--s-2) 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .next li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .next span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.5px solid var(--teal-bright);
    color: var(--teal-bright);
    font-weight: 700;
    font-size: var(--t-14);
  }

  .direct {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    margin-top: auto;
  }

  .panel .mail {
    font-size: var(--t-20);
    font-weight: 700;
    color: var(--white);
    padding: 0.4rem 0;
  }

  form {
    display: grid;
    gap: var(--s-3);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .pair {
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 560px) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  label,
  legend {
    font-weight: 700;
    padding: 0;
  }

  input:not([type='radio']),
  select,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 0.75rem 0.9rem;
    min-height: 50px;
    width: 100%;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      box-shadow 0.2s;
  }

  input:not([type='radio']):hover,
  select:hover,
  textarea:hover {
    border-color: var(--mist);
  }

  input:not([type='radio']):focus,
  select:focus,
  textarea:focus {
    background: var(--white);
    border-color: var(--thread);
    outline: none;
    box-shadow: 0 0 0 4px rgba(14, 122, 109, 0.18);
  }

  textarea {
    resize: vertical;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .choice {
    position: relative;
    font-weight: 400;
  }

  .choice input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .choice span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 2px solid var(--mist);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .choice:hover span {
    border-color: var(--thread);
  }

  .choice input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .choice input:focus-visible + span {
    outline: 3px solid var(--thread);
    outline-offset: 3px;
  }

  [aria-invalid='true'] {
    border-color: #b42318 !important;
    background: #fef3f2 !important;
  }

  .err {
    color: #b42318;
    font-size: var(--t-16);
  }

  .err:empty {
    display: none;
  }

  button {
    justify-self: start;
    min-width: 14rem;
  }

  button[disabled] {
    opacity: 0.7;
    cursor: wait;
  }

  .result {
    font-weight: 700;
    color: var(--thread-dark);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const result = form.querySelector<HTMLElement>('.result')!;
  const button = form.querySelector<HTMLButtonElement>('button')!;

  const looksReachable = (v: string) => /\S+@\S+\.\S+/.test(v) || v.replace(/\D/g, '').length >= 10;

  const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
    const v = el.value.trim();
    const ok = el.name === 'contact' ? looksReachable(v) : v.length > 0;
    const err = document.getElementById(el.getAttribute('aria-describedby')!)!;
    el.setAttribute('aria-invalid', String(!ok));
    err.textContent = ok ? '' : err.dataset.msg!;
    return ok;
  };

  const required = [...form.querySelectorAll<HTMLInputElement>('[required]')];
  required.forEach((el) => el.addEventListener('blur', () => el.value && check(el)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bad = required.filter((el) => !check(el));
    if (bad.length) {
      bad[0].focus();
      return;
    }
    const data = new FormData(form);
    if (!data.get('access_key')) {
      result.textContent = 'The form is not connected yet. Please email hello@aadyantlabs.dev instead.';
      return;
    }
    button.disabled = true;
    result.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      result.textContent = 'Sent. We will reply within one working day.';
    } catch {
      result.textContent = 'That did not go through. Check your connection and try again, or email hello@aadyantlabs.dev.';
    } finally {
      button.disabled = false;
    }
  });
</script>
