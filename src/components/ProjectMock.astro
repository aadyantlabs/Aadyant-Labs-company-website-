---
// Illustrated UI preview of a project, drawn in HTML/CSS. Decorative only.
// Replaced by a real screenshot once one is passed to <Shot src>.
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const urls: Record<string, string> = {
  euphoria: 'euphoria / register',
  sentia: 'sentia / check-in',
  'club-crumbs': 'club crumbs / events',
  layora: 'layora / leaderboard',
};

// A QR-looking 11x11 pattern: three finder squares plus a fixed scatter
const N = 11;
const qr = Array.from({ length: N * N }, (_, i) => {
  const x = i % N;
  const y = Math.floor(i / N);
  const inFinder = (fx: number, fy: number) => x >= fx && x < fx + 3 && y >= fy && y < fy + 3;
  if (inFinder(0, 0) || inFinder(N - 3, 0) || inFinder(0, N - 3)) return true;
  return (x * 7 + y * 13 + x * y) % 3 === 0;
});
---

<div class={`mock m-${slug}`} aria-hidden="true">
  <div class="chrome"><i></i><i></i><i></i><span>{urls[slug] ?? slug}</span></div>
  <div class="screen">
    {
      slug === 'euphoria' && (
        <div class="eu">
          <div class="card form">
            <b>Register for the fest</b>
            <span class="in" />
            <span class="in" />
            <span class="in half" />
            <span class="cta">Pay ₹299</span>
          </div>
          <div class="side">
            <span class="chip">✓ Payment received</span>
            <div class="gal">
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
            </div>
          </div>
        </div>
      )
    }
    {
      slug === 'sentia' && (
        <div class="se">
          <div class="qr">
            {qr.map((on) => (
              <i class={on ? 'on' : ''} />
            ))}
          </div>
          <div class="info">
            <span class="ok">● Checked in</span>
            <b>Team Vortex</b>
            <span class="row">4 members · CSE</span>
            <span class="row">Hostel block B · Room 12</span>
            <span class="bar">
              <i />
            </span>
            <small>312 of 400 arrived</small>
          </div>
        </div>
      )
    }
    {
      slug === 'club-crumbs' && (
        <div class="cc">
          <div class="tabs">
            <span class="on">Coding</span>
            <span>Robotics</span>
            <span>Design</span>
          </div>
          {['12', '19', '26'].map((d, i) => (
            <div class="ev">
              <span class="date">
                <b>{d}</b>Mar
              </span>
              <span class="lines">
                <i />
                <i class="s" />
              </span>
              <span class={i === 0 ? 'go hot' : 'go'}>RSVP</span>
            </div>
          ))}
        </div>
      )
    }
    {
      slug === 'layora' && (
        <div class="la">
          <svg class="chart" viewBox="0 0 200 60" preserveAspectRatio="none">
            <defs>
              <linearGradient id="la-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2FC6B0" stop-opacity=".45" />
                <stop offset="1" stop-color="#2FC6B0" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d="M0 50 L25 44 L50 46 L75 32 L100 36 L125 22 L150 26 L175 12 L200 8 L200 60 L0 60Z" fill="url(#la-fill)" />
            <path d="M0 50 L25 44 L50 46 L75 32 L100 36 L125 22 L150 26 L175 12 L200 8" fill="none" stroke="#2FC6B0" stroke-width="2" vector-effect="non-scaling-stroke" />
          </svg>
          {[92, 78, 64, 51].map((w, i) => (
            <div class="lb">
              <span class="rank">{i + 1}</span>
              <span class="av" />
              <span class="track">
                <i style={`width:${w}%`} />
              </span>
              <span class="pts">{w * 13}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .mock {
    container-type: inline-size;
    border-radius: 14px;
    overflow: hidden;
    background: #f7f9f8;
    box-shadow: 0 0 0 1px rgba(24, 32, 65, 0.08);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 12px;
    background: #e9eeec;
  }

  .chrome i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cfd8d5;
  }

  .chrome span {
    margin-left: 8px;
    padding: 2px 12px;
    border-radius: 99px;
    background: #fff;
    font-size: 11px;
    color: var(--slate);
    white-space: nowrap;
  }

  .screen {
    aspect-ratio: 16 / 10;
    font-size: 2.3cqw;
    padding: 5%;
    display: grid;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  /* Euphoria: ink with marigold glow */
  .m-euphoria .screen {
    background:
      radial-gradient(circle at 85% 10%, rgba(227, 162, 26, 0.55), transparent 45%),
      radial-gradient(circle at 10% 100%, rgba(108, 92, 231, 0.5), transparent 50%),
      var(--ink);
  }

  .eu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5%;
    align-items: center;
  }

  .card {
    background: #fff;
    border-radius: 0.8em;
    padding: 1.1em;
    display: grid;
    gap: 0.6em;
    box-shadow: 0 1.5em 3em -1em rgba(0, 0, 0, 0.5);
  }

  .card b {
    font: 700 1.05em/1.1 var(--font-display);
    color: var(--ink);
  }

  .in {
    height: 1.7em;
    border-radius: 0.4em;
    border: 0.12em solid var(--mist);
  }

  .in.half {
    width: 60%;
  }

  .cta {
    margin-top: 0.3em;
    padding: 0.6em;
    border-radius: 99px;
    text-align: center;
    background: var(--marigold);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.85em;
  }

  .side {
    display: grid;
    gap: 0.8em;
  }

  .chip {
    justify-self: start;
    padding: 0.45em 0.9em;
    border-radius: 99px;
    background: rgba(52, 211, 153, 0.18);
    color: #6ee7b7;
    font-size: 0.8em;
    font-weight: 700;
  }

  .gal {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45em;
  }

  .gal i {
    aspect-ratio: 1;
    border-radius: 0.5em;
    background: linear-gradient(135deg, #f5c04e, #e3a21a);
  }

  .gal i:nth-child(2) {
    background: linear-gradient(135deg, #8b7cf6, #4c3fb5);
  }
  .gal i:nth-child(3) {
    background: linear-gradient(135deg, #2fc6b0, #0e7a6d);
  }
  .gal i:nth-child(4) {
    background: linear-gradient(135deg, #f472b6, #9d174d);
  }
  .gal i:nth-child(5) {
    background: linear-gradient(135deg, #e2f1ee, #8de3d6);
  }
  .gal i:nth-child(6) {
    background: linear-gradient(135deg, #fbbf24, #b45309);
  }

  /* SENTIA: teal */
  .m-sentia .screen {
    background:
      radial-gradient(circle at 15% 15%, rgba(141, 227, 214, 0.6), transparent 45%),
      linear-gradient(135deg, #0e7a6d, #0a4f47);
  }

  .se {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7%;
    align-items: center;
  }

  .qr {
    display: grid;
    grid-template-columns: repeat(11, 0.85em);
    grid-auto-rows: 0.85em;
    gap: 0.12em;
    padding: 0.9em;
    background: #fff;
    border-radius: 0.8em;
    box-shadow: 0 1.5em 3em -1em rgba(0, 0, 0, 0.45);
  }

  .qr i.on {
    background: var(--ink);
    border-radius: 0.12em;
  }

  .info {
    display: grid;
    gap: 0.45em;
    color: #fff;
  }

  .ok {
    justify-self: start;
    padding: 0.35em 0.8em;
    border-radius: 99px;
    background: #fff;
    color: var(--thread-dark);
    font-size: 0.75em;
    font-weight: 700;
  }

  .info b {
    font: 700 1.6em/1.1 var(--font-display);
  }

  .row {
    font-size: 0.85em;
    opacity: 0.85;
  }

  .info .bar {
    margin-top: 0.5em;
    height: 0.55em;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.2);
    overflow: hidden;
  }

  .info .bar i {
    display: block;
    width: 78%;
    height: 100%;
    background: var(--marigold);
  }

  .info small {
    font-size: 0.7em;
    opacity: 0.8;
  }

  /* Club Crumbs: marigold paper */
  .m-club-crumbs .screen {
    background:
      radial-gradient(circle at 100% 0%, rgba(227, 162, 26, 0.45), transparent 50%),
      var(--marigold-50);
    align-content: center;
  }

  .cc {
    display: grid;
    gap: 0.6em;
  }

  .tabs {
    display: flex;
    gap: 0.4em;
    margin-bottom: 0.3em;
  }

  .tabs span {
    padding: 0.45em 1em;
    border-radius: 99px;
    background: #fff;
    font-size: 0.8em;
    font-weight: 700;
    color: var(--slate);
  }

  .tabs .on {
    background: var(--ink);
    color: #fff;
  }

  .ev {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9em;
    align-items: center;
    padding: 0.6em 0.8em;
    background: #fff;
    border-radius: 0.7em;
    box-shadow: 0 0.6em 1.4em -0.8em rgba(24, 32, 65, 0.4);
  }

  .date {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 0.5em;
    background: var(--teal-50);
    color: var(--thread-dark);
    font-size: 0.7em;
    line-height: 1;
  }

  .date b {
    font: 700 1.5em/1 var(--font-display);
  }

  .lines {
    display: grid;
    gap: 0.35em;
  }

  .lines i {
    height: 0.6em;
    border-radius: 0.3em;
    background: var(--ink);
  }

  .lines i.s {
    width: 55%;
    background: var(--mist);
  }

  .go {
    padding: 0.4em 0.9em;
    border-radius: 99px;
    border: 0.12em solid var(--thread);
    color: var(--thread);
    font-size: 0.7em;
    font-weight: 700;
  }

  .go.hot {
    background: var(--thread);
    color: #fff;
  }

  /* Layora: deep ink with a chart */
  .m-layora .screen {
    background:
      radial-gradient(circle at 90% 100%, rgba(47, 198, 176, 0.35), transparent 50%),
      var(--ink-2);
    align-content: center;
  }

  .la {
    display: grid;
    gap: 0.55em;
  }

  .chart {
    width: 100%;
    height: 4.2em;
    margin-bottom: 0.4em;
  }

  .lb {
    display: grid;
    grid-template-columns: 1.2em 1.6em 1fr 2.6em;
    gap: 0.7em;
    align-items: center;
    padding: 0.45em 0.7em;
    border-radius: 0.6em;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-size: 0.9em;
  }

  .lb:first-of-type {
    background: rgba(227, 162, 26, 0.16);
    box-shadow: inset 0 0 0 0.08em rgba(227, 162, 26, 0.5);
  }

  .rank {
    font: 700 1em/1 var(--font-display);
    opacity: 0.7;
  }

  .av {
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    background: linear-gradient(135deg, #2fc6b0, #3b2f8f);
  }

  .track {
    height: 0.5em;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .track i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #0e7a6d, #2fc6b0);
  }

  .lb:first-of-type .track i {
    background: linear-gradient(90deg, #e3a21a, #f5c04e);
  }

  .pts {
    text-align: right;
    font-size: 0.8em;
    opacity: 0.8;
  }
</style>
