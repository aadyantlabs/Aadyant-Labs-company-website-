---
// The one bold element: a line from आद्यन्त (beginning) to the contact form (end).
// Place inside a full-width position:relative container; it spans that container's height.
---

<svg class="thread" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="thread-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100%">
      <stop offset="0" stop-color="#E3A21A"></stop>
      <stop offset="0.12" stop-color="#2FC6B0"></stop>
      <stop offset="0.7" stop-color="#0E7A6D"></stop>
      <stop offset="1" stop-color="#0E7A6D"></stop>
    </linearGradient>
  </defs>
  <line class="thread-base" x1="50%" y1="0" x2="50%" y2="100%"></line>
  <line class="thread-draw" x1="50%" y1="0" x2="50%" y2="100%"></line>
  <circle class="thread-tip" cx="50%" cy="0" r="5"></circle>
</svg>

<style>
  .thread {
    --top: calc(var(--hero-gap) + 0.9rem);
    --end: calc(var(--section-gap) + 56px); /* where the line turns into the contact card */
    position: absolute;
    top: var(--top);
    left: calc(var(--line-x) - 8px);
    width: 16px;
    height: calc(100% - var(--top) - var(--end));
    overflow: visible;
    pointer-events: none;
    z-index: 2;
  }

  line {
    stroke-width: 2;
    stroke-linecap: round;
  }

  .thread-base {
    stroke: rgba(120, 132, 155, 0.28);
  }

  .thread-draw {
    stroke: url(#thread-grad);
    stroke-width: 2.5;
  }

  .thread-tip {
    display: none;
    fill: #fff;
    stroke: var(--teal-bright);
    stroke-width: 2.5;
    filter: drop-shadow(0 0 6px rgba(47, 198, 176, 0.9)) drop-shadow(0 0 14px rgba(47, 198, 176, 0.6));
  }

  :global(.motion) .thread-tip {
    display: block;
  }

  @media (max-width: 767px) {
    line {
      stroke-width: 1.5;
    }
    .thread-draw {
      stroke-width: 2;
    }
    .thread-tip {
      r: 3.5;
    }
  }
</style>

<script>
  // Scroll-linked draw. With reduced motion this never runs and the line stays fully drawn.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const svg = document.querySelector<SVGSVGElement>('.thread')!;
    const line = svg.querySelector<SVGLineElement>('.thread-draw')!;
    const tip = svg.querySelector<SVGCircleElement>('.thread-tip')!;
    let len = 0;
    let queued = false;

    const draw = () => {
      queued = false;
      const box = svg.getBoundingClientRect();
      const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
      // The tip of the line follows a point 60% down the viewport
      const progress = atEnd ? 1 : Math.min(1, Math.max(0, (innerHeight * 0.6 - box.top) / box.height));
      line.style.strokeDashoffset = String(len * (1 - progress));
      tip.setAttribute('cy', String(len * progress));
    };
    const measure = () => {
      len = line.getTotalLength();
      line.style.strokeDasharray = String(len);
      draw();
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(draw);
      }
    };

    measure();
    addEventListener('scroll', onScroll, { passive: true });
    new ResizeObserver(measure).observe(svg);
  }
</script>
