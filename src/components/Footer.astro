---
import { email } from '../data/site';
---

<footer class="wrap">
  <p>Aadyant Labs, Mangaluru. From first idea to launch day.</p>
  <p>
    <a href={`mailto:${email}`}>{email}</a>
    <span aria-hidden="true"> · </span>
    <a href="https://github.com/aadyantlabs">GitHub</a>
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2);
    margin-top: var(--section-gap);
    padding-top: var(--s-4);
    padding-bottom: var(--s-4);
    border-top: 1px solid var(--mist);
    color: var(--slate);
    font-size: var(--t-16);
  }

  a {
    display: inline-block;
    padding: 0.6rem 0;
  }
</style>
