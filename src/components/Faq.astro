---
import { faq, whatsappLink, email } from '../data/site';
---

<section id="faq" class="stop" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="col layout">
      <div class="section-head" data-reveal>
        <p class="kicker">FAQ</p>
        <h2 id="faq-title">Questions clients ask</h2>
        <p class="muted">
          Something else on your mind?
          {whatsappLink ? <a href={whatsappLink}>Ask us on WhatsApp</a> : <a href={`mailto:${email}`}>Email us</a>}.
        </p>
      </div>
      <div class="list">
        {
          faq.map((f, i) => (
            <details data-reveal style={`--d: ${i * 60}ms`}>
              <summary>
                {f.q}
                <span class="plus" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: var(--s-2);
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--s-6);
      align-items: start;
    }
    .section-head {
      position: sticky;
      top: 7rem;
    }
  }

  .list {
    display: grid;
    gap: 0.75rem;
    interpolate-size: allow-keywords;
  }

  details {
    border-radius: 16px;
    background: var(--white);
    border: 1px solid rgba(24, 32, 65, 0.07);
    transition:
      box-shadow 0.4s var(--ease),
      border-color 0.3s;
  }

  details:hover {
    border-color: rgba(14, 122, 109, 0.35);
  }

  details[open] {
    box-shadow: var(--shadow);
    border-color: rgba(14, 122, 109, 0.35);
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease),
      content-visibility 0.45s allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding: 1.15rem 1.25rem;
    font: 600 var(--t-20) / 1.3 var(--font-display);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .plus {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--teal-50);
    transition:
      transform 0.4s var(--ease),
      background-color 0.3s;
  }

  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--thread);
  }

  .plus::after {
    transform: rotate(90deg);
  }

  details[open] .plus {
    transform: rotate(45deg);
    background: var(--thread);
  }

  details[open] .plus::before,
  details[open] .plus::after {
    background: var(--white);
  }

  details p {
    padding: 0 1.25rem 1.25rem;
    color: var(--slate);
  }
</style>
