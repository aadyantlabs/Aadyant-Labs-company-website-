---
import { faq } from '../data/site';
---

<section id="faq" class="stop" aria-labelledby="faq-title">
  <div class="col">
    <div class="section-head">
      <h2 id="faq-title">Questions clients ask</h2>
    </div>
    <div class="list">
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .list {
    max-width: 46rem;
    border-top: 1px solid var(--mist);
  }

  details {
    border-bottom: 1px solid var(--mist);
  }

  summary {
    cursor: pointer;
    padding: var(--s-3) 2rem var(--s-3) 0;
    position: relative;
    font: 600 var(--t-20) / 1.3 var(--font-display);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--thread);
    font-size: var(--t-25);
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    padding-bottom: var(--s-3);
    color: var(--slate);
  }
</style>
