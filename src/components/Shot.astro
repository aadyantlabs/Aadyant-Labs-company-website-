---
// A project screenshot; falls back to the drawn mockup until real screenshots land (Phase 0).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectMock from './ProjectMock.astro';

interface Props {
  slug: string;
  src?: ImageMetadata;
  alt?: string;
}

const { slug, src, alt = '' } = Astro.props;
---

{
  src ? (
    <Image class="shot" src={src} alt={alt} widths={[400, 800, 1200]} sizes="(min-width: 1100px) 800px, 100vw" />
  ) : (
    <ProjectMock slug={slug} />
  )
}

<style>
  .shot {
    border-radius: 14px;
    width: 100%;
  }
</style>
