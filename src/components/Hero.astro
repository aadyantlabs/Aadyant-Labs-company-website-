---
---

<section class="stop hero" aria-labelledby="hero-title">
  <div class="col">
    <p class="mark" lang="sa" aria-hidden="true">आद्यन्त</p>
    <h1 id="hero-title">We build your website or software, from first idea to launch day.</h1>
    <p class="lede muted">
      A small team of engineers from Mangaluru. Fixed prices, 50% to start, and you own everything we build.
    </p>
    <p class="status"><span class="dot" aria-hidden="true"></span>Available for new projects</p>
    <div class="actions">
      <a class="btn" href="#contact">Plan your project</a>
      <a class="btn btn-ghost" href="#work">See our work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    --section-gap: var(--hero-gap);
  }

  /* The name, made visible: Aadi (beginning) to Anta (end) */
  .mark {
    font: 400 clamp(4.5rem, 17vw, 11.5rem) / 1 var(--font-deva);
    color: var(--ink);
    opacity: 0.88;
    margin: -0.2em 0 var(--s-3) -0.04em;
    max-width: none;
  }

  h1 {
    font-size: clamp(var(--t-31), 5.6vw, var(--t-61));
    font-weight: 680;
    font-stretch: 88%;
    max-width: 16ch;
  }

  .lede {
    margin-top: var(--s-3);
    font-size: var(--t-20);
    max-width: 44ch;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--s-3);
    font-size: var(--t-16);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--marigold);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }
</style>
