---
---

<header class="site-header">
  <div class="pill">
    <a class="brand" href="/" aria-label="Aadyant Labs, home">
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <rect width="32" height="32" rx="9" fill="#182041"></rect>
        <path d="M11 7v18h10" stroke="#2FC6B0" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="11" cy="7.5" r="3" fill="#E3A21A"></circle>
      </svg>
      <span>Aadyant Labs</span>
    </a>
    <nav aria-label="Main">
      <a href="/#work">Work</a>
      <a href="/#services">Services</a>
      <a href="/#process">Process</a>
      <a href="/#team">Team</a>
      <a class="btn" href="/#contact">Start a project</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 50;
    padding: 0 var(--edge);
    pointer-events: none;
  }

  .pill {
    pointer-events: auto;
    max-width: calc(var(--max) - 2 * var(--edge));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px) saturate(1.6);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 2px 10px -4px rgba(15, 21, 48, 0.25);
    transition: box-shadow 0.4s var(--ease), background-color 0.4s;
  }

  .scrolled .pill {
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 14px 40px -16px rgba(15, 21, 48, 0.45);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 700 var(--t-20) / 1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  nav a:not(.btn) {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    font-size: var(--t-16);
    transition: background-color 0.2s;
  }

  nav a:not(.btn):hover {
    background: var(--teal-50);
    color: var(--thread-dark);
  }

  .btn {
    min-height: 44px;
    margin-left: 0.4rem;
  }

  @media (max-width: 760px) {
    nav a:not(.btn) {
      display: none;
    }
    .brand span {
      font-size: var(--t-16);
    }
    .btn {
      padding: 0 1.1rem;
    }
  }
</style>
