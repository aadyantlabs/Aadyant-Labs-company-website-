---
import { team } from '../data/site';
---

<section id="team" class="stop" aria-labelledby="team-title">
  <div class="wrap">
    <div class="col">
      <div class="section-head" data-reveal>
        <p class="kicker">Team</p>
        <h2 id="team-title">Who builds it</h2>
        <p class="muted">Engineers from MITE, Mangaluru. You talk directly to the people writing your code.</p>
      </div>
      <ul role="list">
        {
          team.map((m, i) => (
            <li data-reveal style={`--d: ${i * 100}ms`}>
              <span class="ring">
                {m.photo ? (
                  <img src={m.photo} alt={`Photo of ${m.name}`} width="160" height="160" loading="lazy" />
                ) : (
                  <span class="avatar" aria-hidden="true">
                    {m.name.charAt(0)}
                  </span>
                )}
              </span>
              <h3>{m.name}</h3>
              <p class="muted">{m.role}</p>
              <a class="gh" href={`https://github.com/${m.github}`}>
                <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                  />
                </svg>
                GitHub<span class="sr-only"> profile of {m.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 640px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 24rem));
    }
  }

  li {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    padding: var(--s-4);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid rgba(24, 32, 65, 0.07);
    box-shadow: var(--shadow);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  li:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    margin-bottom: var(--s-2);
    border-radius: 50%;
    isolation: isolate;
  }

  .ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--marigold), var(--teal-bright), var(--thread), #3b2f8f, var(--marigold));
    z-index: -1;
    transition: transform 1.2s var(--ease);
  }

  li:hover .ring::before {
    transform: rotate(180deg);
  }

  img,
  .avatar {
    width: 102px;
    height: 102px;
    border-radius: 50%;
    border: 4px solid var(--white);
    object-fit: cover;
  }

  .avatar {
    display: grid;
    place-items: center;
    background: var(--ink);
    font: 700 var(--t-39) / 1 var(--font-display);
    color: var(--white);
  }

  h3 {
    font-size: var(--t-25);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--s-1);
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--t-16);
    transition: background-color 0.2s;
  }

  .gh:hover {
    background: var(--ink);
    color: var(--white);
  }
</style>
