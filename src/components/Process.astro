---
import { steps } from '../data/site';

const when = ['30 minutes, free', 'Within 2 days', 'Work starts', 'Every week', 'Launch day', '30 days after'];
---

<section id="process" class="stop band dark process" aria-labelledby="process-title" data-spotlight>
  <div class="fx" aria-hidden="true"><span class="spot"></span></div>
  <div class="wrap">
    <div class="col">
      <div class="section-head" data-reveal>
        <p class="kicker">Process</p>
        <h2 id="process-title">How a project runs</h2>
        <p class="muted">Six steps, no surprises. You always know what is happening and what it costs.</p>
      </div>
      <!-- The only numbered list on the site, because this really is a sequence -->
      <ol>
        {
          steps.map((s, i) => (
            <li data-reveal style={`--d: ${(i % 3) * 90}ms`}>
              <span class="num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="when">{when[i]}</span>
              <p>{s}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    --bg: var(--ink);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(800px 400px at 100% 0%, rgba(59, 47, 143, 0.55), transparent 70%),
      radial-gradient(700px 400px at 0% 100%, rgba(14, 122, 109, 0.45), transparent 70%),
      var(--ink);
  }

  .fx,
  .spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }

  .spot {
    background: radial-gradient(380px circle at var(--mx, -500px) var(--my, -500px), rgba(47, 198, 176, 0.14), transparent 70%);
  }

  h2 {
    color: var(--white);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
    counter-reset: none;
  }

  @media (min-width: 700px) {
    ol {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  li {
    position: relative;
    padding: var(--s-4) var(--s-3) var(--s-3);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(6px);
    transition:
      border-color 0.4s,
      background-color 0.4s,
      transform 0.5s var(--ease);
  }

  li:hover {
    border-color: rgba(47, 198, 176, 0.55);
    background: rgba(47, 198, 176, 0.07);
    transform: translateY(-4px);
  }

  .num {
    display: block;
    font: 800 clamp(3rem, 5vw, 4rem) / 1 var(--font-display);
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #f5c04e, #2fc6b0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .when {
    display: inline-block;
    margin: var(--s-2) 0 0.5rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-size: var(--t-14);
    color: var(--on-dark-muted);
  }

  li p {
    font-size: var(--t-20);
    line-height: 1.4;
    color: var(--on-dark);
  }
</style>
