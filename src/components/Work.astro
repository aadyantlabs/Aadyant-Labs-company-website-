---
import { getCollection } from 'astro:content';
import Shot from './Shot.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="stop" aria-labelledby="work-title">
  <div class="wrap">
    <div class="col">
      <div class="section-head" data-reveal>
        <p class="kicker">Selected work</p>
        <h2 id="work-title">Things we have built and shipped</h2>
        <p class="muted">Real portals and platforms, used by real people. Not templates.</p>
      </div>
      <ul class="grid" role="list">
        {
          projects.map((p, i) => (
            <li class:list={['item', `item-${i}`]} data-reveal style={`--d: ${(i % 2) * 100}ms`}>
              <a class="card" href={`/work/${p.id}/`}>
                <div class="media">
                  <Shot slug={p.id} />
                </div>
                <div class="text">
                  <span class="tag">{p.data.tag}</span>
                  <h3>{p.data.title}</h3>
                  <p class="muted">{p.data.summary}</p>
                  <span class="more">Read the case study</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  .card {
    display: grid;
    height: 100%;
    gap: var(--s-3);
    padding: 12px 12px var(--s-3);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid rgba(24, 32, 65, 0.07);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .card:hover {
    color: var(--ink);
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .media {
    border-radius: 14px;
    overflow: hidden;
  }

  .media > :global(*) {
    transition: transform 0.8s var(--ease);
  }

  .card:hover .media > :global(*) {
    transform: scale(1.035);
  }

  .text {
    padding: 0 var(--s-2);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .tag {
    justify-self: start;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--marigold-50);
    color: #7a5200;
    font-size: var(--t-14);
    font-weight: 700;
  }

  .item-1 .tag,
  .item-3 .tag {
    background: var(--teal-50);
    color: var(--thread-dark);
  }

  h3 {
    font-size: var(--t-31);
  }

  .more {
    margin-top: 0.4rem;
    justify-self: start;
    color: var(--thread);
    font-weight: 700;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    padding-bottom: 2px;
    transition: background-size 0.4s var(--ease);
  }

  .card:hover .more {
    background-size: 100% 2px;
  }

  /* One large, three smaller in varied sizes */
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: repeat(12, 1fr);
    }
    .item-0,
    .item-3 {
      grid-column: 1 / -1;
    }
    .item-0 .card,
    .item-3 .card {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
      padding: 14px;
    }
    .item-3 .card {
      grid-template-columns: 1fr 1.5fr;
    }
    .item-3 .media {
      order: 2;
    }
    .item-0 h3,
    .item-3 h3 {
      font-size: var(--t-49);
    }
    .item-1 {
      grid-column: span 7;
    }
    .item-2 {
      grid-column: span 5;
    }
  }
</style>
